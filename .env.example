# =============================================================================
#  Pizza Guy's Time — Bot Configuration
# -----------------------------------------------------------------------------
#  Copy this file to `.env` and fill it in. NEVER commit `.env`.
#
#  Only secrets and bootstrap identifiers live here. Everything else — staff
#  role IDs, log channels, ticket settings, security thresholds — is stored in
#  MongoDB and configured in Discord with /setup and /config, so nothing needs
#  a redeploy to change.
# =============================================================================

# ---- Required ---------------------------------------------------------------
# Developer Portal > Your App > Bot > Reset Token
BOT_TOKEN=
# Developer Portal > Your App > General Information > Application ID
CLIENT_ID=
# The guild this instance serves (commands deploy here instantly)
GUILD_ID=
# e.g. mongodb+srv://user:pass@cluster.mongodb.net/pizzabot
MONGO_URI=

# ---- Runtime ----------------------------------------------------------------
# production | development
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---- Bot owners -------------------------------------------------------------
# Comma-separated Discord user IDs that bypass every permission check.
# Keep this to 1-2 people. This is the only permission setting in .env — it is
# the bootstrap that lets you run /setup before any staff roles are configured.
OWNER_IDS=

# ---- Optional bootstrap -----------------------------------------------------
# If set, /setup pre-fills these instead of you picking them in the wizard.
# Everything here can also be set later with /config.
SETUP_STAFF_ROLE=
SETUP_TICKET_CATEGORY=
SETUP_LOG_SECURITY=
SETUP_LOG_MODERATION=
SETUP_LOG_TICKETS=
SETUP_LOG_STAFF=
SETUP_LOG_SERVER=

# ---- Transcript web viewer --------------------------------------------------
# Serves ticket transcripts as a web page. Disabled by default; when off, the
# bot falls back to attaching the HTML file to the ticket log.
WEB_ENABLED=false
WEB_PORT=3000
# Binds to loopback by default. Ticket transcripts contain personal data, so
# exposing them should be deliberate: put a reverse proxy with TLS in front,
# or set this to 0.0.0.0 knowingly.
WEB_HOST=127.0.0.1
# Public origin used to build links. Required when WEB_ENABLED=true.
# e.g. https://tickets.yourdomain.com
WEB_BASE_URL=
# Only enable behind a reverse proxy — otherwise any client can spoof its IP
# and reset its own rate limit.
WEB_TRUST_PROXY=false

# ---- Game data ingest -------------------------------------------------------
# Shared secret your Roblox game signs its event reports with. At least 32
# characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Playtime, levels, purchases and in-game events CANNOT be read from Roblox —
# your game has to send them. See docs/GAME-INTEGRATION.md.
# Leave blank to disable the ingest endpoint entirely.
GAME_API_KEY=
# Accept a plain bearer token instead of an HMAC signature. Weaker: anything
# that sees the request sees the key. Only over HTTPS, and only if you must.
GAME_ALLOW_BEARER=false

# ---- Roblox (reserved — no API calls are made yet) --------------------------
# Present so deployment configs do not change when the integration lands.
ROBLOX_GROUP_ID=
ROBLOX_UNIVERSE_ID=
ROBLOX_API_KEY=
