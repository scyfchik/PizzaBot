# =============================================================================
#  Pizza Guy's Time — Bot Configuration
# -----------------------------------------------------------------------------
#  Copy this file to `.env` and fill it in. NEVER commit `.env`.
#
#  Only secrets and bootstrap identifiers live here. Everything else — staff
#  role IDs, log channels, ticket settings, security thresholds — is stored in
#  MongoDB and configured in Discord with /setup and /config, so nothing needs
#  a redeploy to change.
# =============================================================================

# ---- Required ---------------------------------------------------------------
# Developer Portal > Your App > Bot > Reset Token
BOT_TOKEN=
# Developer Portal > Your App > General Information > Application ID
CLIENT_ID=
# The guild this instance serves (commands deploy here instantly)
GUILD_ID=
# e.g. mongodb+srv://user:pass@cluster.mongodb.net/pizzabot
MONGO_URI=

# ---- Runtime ----------------------------------------------------------------
# production | development
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---- Bot owners -------------------------------------------------------------
# Comma-separated Discord user IDs that bypass every permission check.
# Keep this to 1-2 people. This is the only permission setting in .env — it is
# the bootstrap that lets you run /setup before any staff roles are configured.
OWNER_IDS=

# ---- Optional bootstrap -----------------------------------------------------
# If set, /setup pre-fills these instead of you picking them in the wizard.
# Everything here can also be set later with /config.
SETUP_STAFF_ROLE=
SETUP_TICKET_CATEGORY=
SETUP_LOG_SECURITY=
SETUP_LOG_MODERATION=
SETUP_LOG_TICKETS=
SETUP_LOG_STAFF=
SETUP_LOG_SERVER=

# ---- Roblox (reserved — no API calls are made yet) --------------------------
# Present so deployment configs do not change when the integration lands.
ROBLOX_GROUP_ID=
ROBLOX_UNIVERSE_ID=
ROBLOX_API_KEY=
